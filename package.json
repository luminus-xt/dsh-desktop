{
  "name": "dsh-desktop-wsl",
  "productName": "DeepSeek Harness (WSL)",
  "version": "0.2.1",
  "description": "WSL 适配版：Windows 桌面客户端，连接 WSL 中已有的 DeepSeek Harness Web UI。支持主动更新 WSL 内 DSH、选区截图提问、系统托盘、会话管理。",
  "main": "src/main.js",
  "license": "MIT",
  "author": "luminus-xt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luminus-xt/dsh-desktop.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "electron",
    "desktop",
    "windows",
    "wsl"
  ],
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop.wsl",
    "productName": "DeepSeek Harness (WSL)",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "dsh-desktop-wsl-${version}-setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeepSeek Harness (WSL)"
    }
  }
}

